{
  "uid": "adsb-receiver",
  "title": "ADS-B · Receiver health",
  "description": "How well the Uppsala receiver is hearing. Scraped from readsb's Prometheus endpoint and node-exporter on the Pi.",
  "tags": [
    "adsb",
    "flightradar"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ],
    "quick_ranges": [
      {
        "display": "Last 6 hours",
        "from": "now-6h",
        "to": "now"
      },
      {
        "display": "Today",
        "from": "now/d",
        "to": "now/d"
      },
      {
        "display": "Last 24 hours",
        "from": "now-24h",
        "to": "now"
      },
      {
        "display": "Last 7 days",
        "from": "now-7d",
        "to": "now"
      },
      {
        "display": "Last 30 days",
        "from": "now-30d",
        "to": "now"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
